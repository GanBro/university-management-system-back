<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.wubo.api.mapper.MenuMapper">

    <!-- 查询顶层菜单 -->
    <select id="getMenuList" resultMap="menuMap">
        SELECT * FROM menu WHERE parent_id = 0
    </select>

    <!-- ResultMap 映射 -->
    <resultMap id="menuMap" type="com.wubo.api.entity.Menu">
        <id property="menuId" column="menu_id"/>
        <result column="name" property="name"/>
        <result column="redirect" property="redirect"/>
        <result column="component" property="component"/>
        <result column="path" property="path"/>
        <result column="parent_id" property="parentId"/>
        <result column="meta" property="meta" typeHandler="com.wubo.api.handler.MetaTypeHandler"/>
        <!-- 子菜单 -->
        <collection property="children" column="menu_id" select="com.wubo.api.mapper.MenuMapper.getSubMenuList"/>
    </resultMap>

    <!-- 查询子菜单 -->
    <select id="getSubMenuList" parameterType="int" resultMap="menuMap">
        SELECT * FROM menu WHERE parent_id = #{parentId}
    </select>

</mapper>
