<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.wubo.api.mapper.UniversitySatisfactionMapper">

    <!-- 通用结果映射 -->
    <resultMap id="BaseResultMap" type="com.wubo.api.entity.UniversitySatisfaction">
        <id column="id" property="id"/>
        <result column="university_id" property="universityId"/>
        <result column="overall_rating" property="overallRating"/>
        <result column="overall_count" property="overallCount"/>
        <result column="environment_rating" property="environmentRating"/>
        <result column="environment_count" property="environmentCount"/>
        <result column="life_rating" property="lifeRating"/>
        <result column="life_count" property="lifeCount"/>
        <result column="created_at" property="createdAt"/>
        <result column="updated_at" property="updatedAt"/>
    </resultMap>

    <!-- 满意度DTO结果映射 -->
    <resultMap id="SatisfactionDTOMap" type="com.wubo.api.dto.UniversitySatisfactionDTO">
        <result column="id" property="id"/>
        <result column="name" property="name"/>
        <result column="location" property="location"/>
        <result column="overall_rating" property="overallRating"/>
        <result column="overall_count" property="overallCount"/>
        <result column="environment_rating" property="environmentRating"/>
        <result column="environment_count" property="environmentCount"/>
        <result column="life_rating" property="lifeRating"/>
        <result column="life_count" property="lifeCount"/>
    </resultMap>

    <!-- 分页查询院校满意度 -->
    <select id="selectSatisfactionPage" resultMap="SatisfactionDTOMap">
        SELECT
        u.id,
        u.name,
        u.province as location,
        s.overall_rating,
        s.overall_count,
        s.environment_rating,
        s.environment_count,
        s.life_rating,
        s.life_count
        FROM
        university u
        LEFT JOIN
        university_satisfaction s ON u.id = s.university_id
        <where>
            <if test="params.name != null and params.name != ''">
                AND u.name LIKE CONCAT('%', #{params.name}, '%')
            </if>
            <if test="params.location != null and params.location != ''">
                AND u.province = #{params.location}
            </if>
            <if test="params.department != null and params.department != ''">
                AND u.admin_department = #{params.department}
            </if>
            <if test="params.level != null and params.level != ''">
                AND u.level = #{params.level}
            </if>
            <if test="params.feature != null and params.feature != ''">
                AND EXISTS (
                SELECT 1 FROM university_feature uf
                WHERE uf.university_id = u.id AND uf.feature_name = #{params.feature}
                )
            </if>
        </where>
        ORDER BY
        CASE WHEN s.overall_rating IS NULL THEN 1 ELSE 0 END,
        s.overall_rating DESC,
        u.id
    </select>
</mapper>
